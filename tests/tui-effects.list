# Manifest for tests/tui-effects.sh: every entry of the Super+A main menu
# (MENU_KEYS in scripts/appbinds/appbinds.sh) and the test that proves its EFFECT.
#
#   key|kind|suite|marker
#
# kind   state = the entry changes something (a file, Hyprland, a daemon)
#        read  = the entry only shows information (suite and marker stay empty)
# suite  file in tests/ that runs in tests/run-all.sh
# marker exact text from that suite: the check that READS the resulting state
#        (a .dat file, a generated config, the mock's answer), not one that only
#        sees the command being called or the menu being opened
#
# A new menu entry without a row here fails the suite. So does a row whose
# marker no longer exists, because someone removed or renamed the effect check.
a|state|appbinds-menu.sh|check "bind zapisany"
a|state|appbinds-menu.sh|check "bind cofnięty"
a|state|appbinds-menu.sh|check "[a] nieudany zapis: bez ✓, plik bez zmian"
e|state|appbinds-menu.sh|check "[e] zmienia komendę wybranego"
e|state|appbinds-menu.sh|check "[e] błąd configu: bez ✓ Changed, cofnięte"
e|state|appbinds-menu.sh|check "[e] nieudany zapis: bez ✓, plik bez zmian"
d|state|appbinds-menu.sh|check "[d] usuwa i sprawdza reload"
d|state|appbinds-menu.sh|check "[d] błąd configu: bez ✓ Removed, bind wraca"
s|read||
w|state|appbinds-menu.sh|check "tryb zmieniony i plik wygenerowany"
w|state|machine-layer.sh|echo "== workspace-mode-switch.sh"
w|state|appbinds-menu.sh|check "[w] nieudany zapis trybu: tryb i reguły jak przedtem"
w|state|appbinds-menu.sh|check "[w] guard wystartowany i odczytany"
w|state|appbinds-menu.sh|check "[w] guard nie wstał: bez ✓ guarda"
n|state|monitor-settings.sh|check "l 1: zewnętrzny na lewą stronę"
n|state|monitor-settings.sh|check "odmowa: pliki i Hyprland jak przedtem"
n|state|monitor-settings.sh|check "po y bez zielonego sukcesu"
n|state|monitor-settings.sh|check "numery bez ruszania ekranów"
n|state|monitor-settings.sh|check "plik .dat z odczytu Hyprlanda"
n|state|monitor-settings.sh|check "wpis usunięty"
k|state|keyboard-layouts.sh|ok "Hyprland: kod 0 i ✓"
k|state|keyboard-layouts.sh|ok "terminal: [k] → 2 → ↓ Enter → us,pl"
k|state|keyboard-layouts.sh|ok "terminal: Esc anuluje bez zmian"
k|state|keyboard-layouts.sh|ok "TUI [k] → 2 → wpisana permutacja '3 1 2' → de,pl,us"
m|state|mouse-settings.sh|ok "Hyprland: kod 0 i komunikat ✓"
v|state|appbinds-menu.sh|check "wybór zapisany"
v|state|appbinds-menu.sh|check "[v] bez waybara: zapisane, bez ✓"
v|state|appbinds-menu.sh|check "[v] waybar działa: ✓ po sygnale 10"
l|state|appbinds-menu.sh|check "[l] archenemy: plik i JSON paska"
l|state|appbinds-menu.sh|check "[l] distro: plik i glif w JSON paska"
l|state|appbinds-menu.sh|check "[l] waybar działa: ✓ po sygnale 12"
l|state|appbinds-menu.sh|check "[l] bez waybara: zapisane, bez ✓"
l|state|appbinds-menu.sh|check "[l] niezapisywalny katalog: stary stan"
l|state|appbinds-menu.sh|check "[l] rice bez launchera: zapisane, bez ✓"
l|state|launcher-logo.sh|expect "brak pliku .dat → distro (glif Archa)"
l|state|appbinds-menu.sh|check "[l] archenemy: fastfetch dostaje znak Æ"
l|state|appbinds-menu.sh|check "[l] distro: plik logo fastfetcha znika"
l|state|appbinds-menu.sh|check "[l] usługa działa i motyw ma nowe logo: ✓ po odczycie"
l|state|system-theme.sh|check "logo archenemy: SDDM i GRUB przełączone"
g|state|appbinds-menu.sh|check "[g] wybór podłączonego monitora: żywa nazwa złącza w pliku"
g|state|appbinds-menu.sh|check "[g] motyw ma wybrany monitor: ✓ po odczycie"
g|state|system-theme.sh|check "wybór z TUI: loginScreen=eDP-1"
t|state|appbinds-menu.sh|check "włączenie zapisane"
t|state|appbinds-menu.sh|check "[t] bez waybara: zapisane, bez ✓ shown"
t|state|appbinds-menu.sh|check "[t] waybar działa: ✓ po sygnale 11"
c|state|terminal-settings.sh|check "switches on to off"
f|state|font-settings.sh|check "family zapisane"
p|state|autostart-picker.sh|check "brak pliku Lua → nie ma sukcesu"

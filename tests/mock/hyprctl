#!/bin/bash
# Atrapa hyprctl do tests/machine-layer.sh i tests/wallpaper-switcher.sh.
# MOCK_MONS = both (eDP-1 + HDMI-A-3 — realny zrzut 2026-09-21, nazwy złączy
#             zmienione względem eDP-2/HDMI-A-1 z dnia instalacji)
#           | edp   (tylko panel — HDMI odpięty)
#           | twins (dwa identyczne monitory bez numeru seryjnego)
# Formaty tekstowe wg src/debug/HyprCtl.cpp v0.56.2. dispatch → $MOCK_LOG.
#
# Gałąź `hyprpaper` modeluje DEMONA hyprpapera 0.8.4 w tym jednym aspekcie,
# który decyduje o widocznej tapecie (źródła: hyprpaper 0.8.4
# src/config/WallpaperMatcher.cpp i src/ipc/IPC.cpp; klient: Hyprland v0.56.2
# hyprctl/src/hyprpaper/Hyprpaper.cpp):
#   * ustawienia to LISTA wpisów "klucz → ścieżka" w kolejności dodania;
#     config wchodzi przy starcie demona, IPC dokłada NA KONIEC, kasując
#     wcześniej tylko wpis o IDENTYCZNYM kluczu (addState),
#   * monitor dostaje PIERWSZY pasujący wpis (matchSetting): klucz równy
#     nazwie złącza albo "desc:<opis>" pasujący po PREFIKSIE opisu,
#   * `wallpaper` odrzuca monitor, którego nie ma (outputExists: nazwa
#     dosłownie albo "desc:"+opis DOKŁADNIE) i ścieżkę, której nie ma,
#   * `listactive` wypisuje "<nazwa złącza>: <ścieżka>" dla monitorów
#     z dopasowanym wpisem.
# Stan demona: plik $MOCK_HYPRPAPER_STATE (linie "klucz<TAB>ścieżka"); brak
# pliku = demon nie działa (jak po pkill) → IPC kończy się błędem.
mock_desc() {   # nazwa złącza → opis EDID (jak w zrzutach niżej)
    case "$1" in
        eDP-1)     echo "Thermotrex Corporation TL160ADMP03-0" ;;
        HDMI-A-3)  echo "Microstep MSI G241 0x00000603" ;;
        DP-1|DP-2) echo "Acme Twin 24" ;;
    esac
}
mock_live_names() {
    case "${MOCK_MONS:-both}" in
        twins) printf 'DP-1\nDP-2\n' ;;
        edp)   printf 'eDP-1\n' ;;
        *)     printf 'HDMI-A-3\neDP-1\n' ;;
    esac
}
mock_match() {   # pierwszy pasujący wpis dla monitora (matchSetting)
    local name="$1" desc key path
    desc="desc:$(mock_desc "$name")"
    while IFS=$'\t' read -r key path; do
        [[ -n "$key" ]] || continue
        if [[ "$key" == "$name" || "$desc" == "$key"* ]]; then
            printf '%s\n' "$path"
            return 0
        fi
    done < "$MOCK_HYPRPAPER_STATE"
    return 1
}

case "$1" in
  hyprpaper)
    [[ -f "${MOCK_HYPRPAPER_STATE:-/nonexistent}" ]] || { echo "can't send: failed to connect to hyprpaper (is it running?)" >&2; exit 1; }
    case "$2" in
      wallpaper)
        IFS=',' read -r MON WP_PATH _FIT <<< "$3"
        MON="${MON#"${MON%%[![:space:]]*}"}"; MON="${MON%"${MON##*[![:space:]]}"}"
        WP_PATH="${WP_PATH#"${WP_PATH%%[![:space:]]*}"}"; WP_PATH="${WP_PATH%"${WP_PATH##*[![:space:]]}"}"
        exists=0
        while IFS= read -r n; do
            [[ "$MON" == "$n" || "$MON" == "desc:$(mock_desc "$n")" ]] && exists=1
        done < <(mock_live_names)
        [[ "$exists" -eq 1 ]] || { echo "failed to set wallpaper: Invalid monitor" >&2; exit 1; }
        [[ "$WP_PATH" == /* && -e "$WP_PATH" ]] || { echo "failed to set wallpaper: Invalid path" >&2; exit 1; }
        echo "IPC wallpaper $MON -> $WP_PATH" >> "${MOCK_LOG:-/dev/null}"
        tmp=$(mktemp)
        awk -F'\t' -v m="$MON" '$1 != m' "$MOCK_HYPRPAPER_STATE" > "$tmp"
        printf '%s\t%s\n' "$MON" "$WP_PATH" >> "$tmp"
        mv "$tmp" "$MOCK_HYPRPAPER_STATE"
        exit 0 ;;
      listactive)
        while IFS= read -r n; do
            p=$(mock_match "$n") && printf '%s: %s\n' "$n" "$p"
        done < <(mock_live_names)
        exit 0 ;;
      *) exit 1 ;;
    esac ;;
  monitors)
    if [[ "${MOCK_MONS:-both}" == twins ]]; then
cat <<'M'
Monitor DP-1 (ID 0):
	1920x1080@60.00000 at 0x0
	description: Acme Twin 24
	make: Acme
	model: Twin 24
	serial: 
	active workspace: 1 (1)
	scale: 1.00
	focused: yes
	disabled: false

Monitor DP-2 (ID 1):
	1920x1080@60.00000 at 1920x0
	description: Acme Twin 24
	make: Acme
	model: Twin 24
	serial: 
	active workspace: 2 (2)
	scale: 1.00
	focused: no
	disabled: false

M
      exit 0
    fi
    if [[ "${MOCK_MONS:-both}" == both ]]; then
cat <<'M'
Monitor HDMI-A-3 (ID 0):
	1920x1080@144.00000 at 1925x123
	description: Microstep MSI G241 0x00000603
	make: Microstep
	model: MSI G241
	serial: 0x00000603
	active workspace: 11 (1)
	scale: 1.00
	focused: no
	disabled: false

M
    fi
cat <<'M'
Monitor eDP-1 (ID 1):
	2560x1600@240.00000 at 0x0
	description: Thermotrex Corporation TL160ADMP03-0
	make: Thermotrex Corporation
	model: TL160ADMP03-0
	serial: 
	active workspace: 2 (2)
	scale: 1.33
	focused: yes
	disabled: false

M
    ;;
  workspaces)
    # MOCK_WS=stale — realny zrzut 2026-09-21: reguły były na stare nazwy,
    # Hyprland wziął pierwsze wolne numery poza dekadami (21 na HDMI, 22 na eDP)
    if [[ "${MOCK_WS:-}" == stale ]]; then
      printf 'workspace ID 21 (21) on monitor HDMI-A-3:\n\twindows: 2\nworkspace ID 22 (22) on monitor eDP-1:\n\twindows: 1\n'
    else
      printf 'workspace ID 2 (2) on monitor eDP-1:\n\twindows: 1\nworkspace ID 11 (1) on monitor eDP-1:\n\twindows: 1\n'
    fi ;;
  clients)
    if [[ "${MOCK_WS:-}" == stale ]]; then
      printf 'Window aaaa -> brave:\n\tworkspace: 21 (21)\nWindow cccc -> alacritty:\n\tworkspace: 21 (21)\nWindow bbbb -> y:\n\tworkspace: 22 (22)\n'
    else
      printf 'Window aaaa -> x:\n\tworkspace: 11 (1)\nWindow bbbb -> y:\n\tworkspace: 2 (2)\n'
    fi ;;
  activeworkspace)
    if [[ "${MOCK_WS:-}" == stale ]]; then echo 'workspace ID 22 (22) on monitor eDP-1:'; else echo 'workspace ID 2 (2) on monitor eDP-1:'; fi ;;
  dispatch) echo "dispatch $*" >> "${MOCK_LOG:-/dev/null}" ;;
esac

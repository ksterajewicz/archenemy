// archenemy — fastfetch (yang rice: papier, szarości, czerń — odwrotność yin)
// Logo: wbudowane logo WYKRYTEJ dystrybucji (type builtin bez source — Arch na
// Archu, Fedora na Fedorze, NixOS na NixOS), kolory 1–6: Arch i Fedora zużywają
// $1–$2, NixOS $1–$6 (nieparzyste = pierwszy kolor, parzyste = drugi).
// yang: czerń #0C0C0E (akcent) i popiół #5E5E66 (5,3:1 na najgorszym tle szkła).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "color": {
      "1": "38;2;12;12;14", "2": "38;2;94;94;102",
      "3": "38;2;12;12;14", "4": "38;2;94;94;102", "5": "38;2;12;12;14", "6": "38;2;94;94;102"
    },
    "padding": { "top": 1, "right": 4, "left": 2 }
  },

  // Klucze i tytuł w czerni (97 = bright white, w palecie yang #0C0C0E —
  // ANSI trzyma kolejność kontrastu yin), wartości w grafitowej szarości
  // (37 = #232327), separatory przygaszone (90 = #67676E). Kolory jako surowe
  // kody SGR — nazwa „bright_white" dawała pogrubioną zwykłą biel (1;37).
  // Bez display.key.width — obcinał ręcznie wyrównane klucze („KERN" → „KE").
  "display": {
    "separator": "  ",
    "color": { "keys": "97", "title": "97", "output": "37" }
  },

  // Klucze = krótkie etykiety w stylu „panelu przyrządów" (bez ikon spoza
  // pewnego zakresu glifów — świadoma decyzja, żeby nic nie wyszło jako tofu).
  "modules": [
    "break",
    { "type": "title" },
    { "type": "custom", "format": "{#90}────────────────────────────────" },
    { "type": "os",           "key": "OS   " },
    { "type": "kernel",       "key": "KERN " },
    { "type": "host",         "key": "HOST " },
    { "type": "uptime",       "key": "UP   " },
    { "type": "packages",     "key": "PKGS " },
    { "type": "shell",        "key": "SHELL" },
    { "type": "wm",           "key": "WM   " },
    { "type": "terminal",     "key": "TERM " },
    // Font terminala z uwzględnieniem wyboru Super+A → [f] (rodzina jest w importach alacritty).
    // fastfetch po cichu pomija wiersz, gdy polecenie nic nie wypisze albo skończy się
    // kodem 127 (np. brak skryptu), więc zapasowo (także gdy skrypt wypisze „unknown…”)
    // czytamy te same pliki co alacritty; wynik nigdy nie jest pusty.
    { "type": "command",      "key": "FONT ", "text": "f=$(bash \"$HOME/archenemy/scripts/appbinds/font-settings.sh\" current 2>/dev/null); case \"$f\" in ''|unknown*) g=$(sed -n 's/^[[:space:]]*family[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1 (alacritty config)/p' \"$HOME/.config/archenemy/fonts/alacritty.toml\" \"$HOME/.config/alacritty/font.toml\" 2>/dev/null | head -n 1); [ -n \"$g\" ] && f=$g ;; esac; echo \"${f:-unknown (font-settings.sh and alacritty font files unavailable)}\"" },
    { "type": "custom", "format": "{#90}────────────────────────────────" },
    { "type": "cpu",          "key": "CPU  " },
    { "type": "gpu",          "key": "GPU  " },
    { "type": "memory",       "key": "MEM  " },
    // Pojemność każdego fizycznego dysku (hideVirtual: bez zram, dm-* i loop*),
    // potem każdy zamontowany system plików: zwykłe partycje i dyski zewnętrzne;
    // bez pseudo-FS (tmpfs, proc…), ukrytych i podwoluminów btrfs. Tylko opcje
    // modułów — zero nazw urządzeń i ścieżek.
    { "type": "physicaldisk", "key": "DRIVE", "format": "{name}  {size}", "hideVirtual": true },
    { "type": "disk",         "key": "DISK ", "format": "{mountpoint}  {size-used} / {size-total} ({size-percentage})",
      "showRegular": true, "showExternal": true, "showHidden": false, "showSubvolumes": false, "showUnknown": false },
    { "type": "battery",      "key": "BAT  " },
    "break",
    // Kropki palety: oba rzędy ANSI (zwykłe i jasne) — widać schodki szarości
    // i jedyny ciepły kolor (rdza, pozycja „red").
    { "type": "custom", "format": "{#30}●  {#31}●  {#32}●  {#33}●  {#34}●  {#35}●  {#36}●  {#37}●" },
    { "type": "custom", "format": "{#90}●  {#91}●  {#92}●  {#93}●  {#94}●  {#95}●  {#96}●  {#97}●" }
  ]
}

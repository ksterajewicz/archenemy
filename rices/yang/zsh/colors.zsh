# =============================================
#   archenemy · yang · kolory zsh
#   Kontrast WCAG >= 4.5:1 względem tła #F3F3F5 (bez przezroczystości).
#   Plik ustawia style; wtyczki ładuje użytkownik osobno.
# =============================================
#   Jasny monochrom jak alacritty/nvim: tusz #1E1E22, akcent czerń #0C0C0E,
#   ścieżki #303035, napisy #46464C, komentarze i podpowiedzi #5E5E66.
#   Rdza #A23A10 wyłącznie dla błędów.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5E5E66'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg=#1E1E22'

// archenemy — fastfetch (crt rice: fosfor błękit/cyjan)
// Własny motyw: wbudowane logo Archa w cyjanie fosforu (#74DCE2) i błękicie (#5695D6).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "arch",
    "color": { "1": "38;2;116;220;226", "2": "38;2;86;149;214" },
    "padding": { "top": 1, "right": 3, "left": 2 }
  },

  // Klucze i tytuł w jasnym cyjanie (= ANSI bright white/cyan alacritty); separatory jako moduł
  // „custom" (kolor bierze z display.color.output → niebieski).
  // Bez display.key.width — obcinał ręcznie wyrównane klucze („KERN" → „KE").
  "display": {
    "separator": "  ",
    "color": { "keys": "white", "title": "white", "output": "blue" }
  },

  // Klucze = krótkie etykiety w stylu „panelu przyrządów" (bez ikon spoza
  // pewnego zakresu glifów — świadoma decyzja, żeby nic nie wyszło jako tofu).
  "modules": [
    "break",
    { "type": "title", "keyColor": "white" },
    { "type": "custom", "format": "────────────────────────────────" },
    { "type": "os",           "key": "OS   " },
    { "type": "kernel",       "key": "KERN " },
    { "type": "host",         "key": "HOST " },
    { "type": "uptime",       "key": "UP   " },
    { "type": "packages",     "key": "PKGS " },
    { "type": "shell",        "key": "SHELL" },
    { "type": "wm",           "key": "WM   " },
    { "type": "terminal",     "key": "TERM " },
    // Font terminala z uwzględnieniem wyboru Super+A → [f] (rodzina jest w importach alacritty).
    { "type": "command",      "key": "FONT ", "text": "\"$HOME/archenemy/scripts/appbinds/font-settings.sh\" current" },
    { "type": "custom", "format": "────────────────────────────────" },
    { "type": "cpu",          "key": "CPU  " },
    { "type": "gpu",          "key": "GPU  " },
    { "type": "memory",       "key": "MEM  " },
    { "type": "disk",         "key": "DISK ", "folders": "/" },
    { "type": "battery",      "key": "BAT  " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}

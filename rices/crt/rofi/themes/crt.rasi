/*
 * rofi theme — crt rice (błękit/cyjan fosforu)
 * accent: #36D2D8 (cyjan) | bright: #74DCE2 | urgent: #FFB000 (bursztyn — fosfor alarmowy)
 * bg: szkło kineskopu — granat #043D7B z alfą 0.72 (≥ ignore_alpha 0.5 → blur)
 * layout: center | corners: 4 — jak rogi obrazu na lampie, spójnie z waybarem
 */

* {
    bg:          rgba(4, 61, 123, 0.72);
    bg-selected: rgba(54, 210, 216, 0.14);
    fg:          #5695D6;
    fg-dim:      rgba(86, 149, 214, 0.45);
    accent:      #36D2D8;
    bright:      #74DCE2;
    urgent:      #FFB000;
    border-col:  rgba(48, 105, 173, 0.60);

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    4px;
    width:            520px;
    padding:          0px;
    location:         center;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

/* ── Input bar ──────────────────────────────────────── */
inputbar {
    background-color: transparent;
    text-color:       @fg;
    padding:          14px 18px;
    spacing:          10px;
    children:         [ prompt, entry ];
    border:           0px 0px 1px 0px solid;
    border-color:     rgba(48, 105, 173, 0.45);
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font 13";
}

entry {
    background-color: transparent;
    text-color:       @bright;
    placeholder:      "Search…";
    placeholder-color: @fg-dim;
    cursor-color:     @accent;
    cursor-width:     2px;
    expand:           true;
}

/* ── List ───────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          8px;
    spacing:          2px;
    scrollbar:        false;
    lines:            8;
    fixed-height:     true;
    cycle:            true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          9px 12px;
    spacing:          10px;
    orientation:      horizontal;
    border-radius:    3px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @bright;
}

element normal.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       #031533;
}

element-icon {
    background-color: transparent;
    size:             20px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    expand:           true;
}

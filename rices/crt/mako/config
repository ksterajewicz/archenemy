# archenemy - mako config (crt rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=10
padding=14,16
anchor=top-right
layer=overlay

# Szkło kineskopu: granat #043D7B z alfą ~0.72 (blur łapie ≥ 0.5), tekst
# w błękicie fosforu, ramka cyjanowa. Rogi 4 px jak w waybarze.
background-color=#043D7BB8
text-color=#74DCE2
border-size=1
border-color=#36D2D899
border-radius=4
progress-color=over #36D2D855

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
text-color=#5695D6
border-color=#3069AD99
default-timeout=3500

[urgency=critical]
# Bursztyn — fosfor alarmowy, jedyny ciepły kolor palety
background-color=#FFB000F0
text-color=#031533
border-color=#FFB000
default-timeout=0

[mode=do-not-disturb]
invisible=1

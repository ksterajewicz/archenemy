// archenemy — fastfetch (asia-n-rice). Zaadaptowany 1:1 ze źródła: bez
// bloku logo/color (domyślne logo Archa i kolory) — tak jak w źródłowym
// rice'u. Można w każdej chwili przebarwić logo/klucze na mauve (jak
// robią white-blue/tron), jeśli właściciel zechce parytetu wizualnego.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    // Font terminala z uwzględnieniem wyboru Super+A → [f]; rodzina jest w importach
    // alacritty (font.toml), których terminalfont może nie uwzględniać. fastfetch po
    // cichu pomija wiersz, gdy polecenie nic nie wypisze (np. skrypt niedostępny),
    // więc zapasowo czytamy te same pliki co alacritty; wynik nigdy nie jest pusty.
    { "type": "command", "key": "Terminal Font", "text": "f=$(bash \"$HOME/archenemy/scripts/appbinds/font-settings.sh\" current 2>/dev/null); [ -n \"$f\" ] || f=$(sed -n 's/^[[:space:]]*family[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1 (alacritty config)/p' \"$HOME/.config/archenemy/fonts/alacritty.toml\" \"$HOME/.config/alacritty/font.toml\" 2>/dev/null | head -n 1); echo \"${f:-unknown (font-settings.sh and alacritty font files unavailable)}\"" },
    "cpu",
    "gpu",
    "memory",
    "swap",
    // Pojemność każdego fizycznego dysku, potem każdy zamontowany system plików:
    // zwykłe partycje i dyski zewnętrzne; bez pseudo-FS (tmpfs, proc…), ukrytych
    // i podwoluminów btrfs. Tylko opcje modułów — zero nazw urządzeń i ścieżek.
    "physicaldisk",
    { "type": "disk", "showRegular": true, "showExternal": true, "showHidden": false, "showSubvolumes": false, "showUnknown": false },
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}

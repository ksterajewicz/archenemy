// archenemy — fastfetch (asia-n-rice). Moduły przeniesione 1:1 z wcześniejszej
// wersji tego rice'a; klucze zostają w domyślnych kolorach fastfetcha.
// Logo systemu (Super+A → [l] system logo): domyślnie wbudowane logo WYKRYTEJ
// dystrybucji; w trybie „archenemy” znak Æ z pliku warstwy maszynowej
// data/fastfetch-logo.txt (zakłada go scripts/waybar/launcher-logo.sh sync)
// w pierwszym kolorze rice'a. "type": "auto" + "source" = plik, a gdy pliku
// nie ma, fastfetch sam wybiera logo dystrybucji (bez stałej nazwy — Arch na
// Archu, Fedora na Fedorze, NixOS na NixOS), kolory 1–6: Arch i Fedora zużywają
// $1–$2, NixOS $1–$6 (nieparzyste = pierwszy kolor, parzyste = drugi).
// asia-n-rice: mauve #B47687 (akcent) i jasny tekst #E8E8E8 (z alacritty).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/archenemy/data/fastfetch-logo.txt",
    "color": {
      "1": "38;2;180;118;135", "2": "38;2;232;232;232",
      "3": "38;2;180;118;135", "4": "38;2;232;232;232", "5": "38;2;180;118;135", "6": "38;2;232;232;232"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    // Font terminala z uwzględnieniem wyboru Super+A → [f]; rodzina jest w importach
    // alacritty (font.toml), których terminalfont może nie uwzględniać. fastfetch po
    // cichu pomija wiersz, gdy polecenie nic nie wypisze albo skończy się kodem 127
    // (np. brak skryptu), więc zapasowo (także gdy skrypt wypisze „unknown…”) czytamy
    // te same pliki co alacritty; wynik nigdy nie jest pusty.
    { "type": "command", "key": "Terminal Font", "text": "f=$(bash \"$HOME/archenemy/scripts/appbinds/font-settings.sh\" current 2>/dev/null); case \"$f\" in ''|unknown*) g=$(sed -n 's/^[[:space:]]*family[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1 (alacritty config)/p' \"$HOME/.config/archenemy/fonts/alacritty.toml\" \"$HOME/.config/alacritty/font.toml\" 2>/dev/null | head -n 1); [ -n \"$g\" ] && f=$g ;; esac; echo \"${f:-unknown (font-settings.sh and alacritty font files unavailable)}\"" },
    "cpu",
    "gpu",
    "memory",
    "swap",
    // Pojemność każdego fizycznego dysku (hideVirtual: bez zram, dm-* i loop*),
    // potem każdy zamontowany system plików: zwykłe partycje i dyski zewnętrzne;
    // bez pseudo-FS (tmpfs, proc…), ukrytych i podwoluminów btrfs. Tylko opcje
    // modułów — zero nazw urządzeń i ścieżek.
    { "type": "physicaldisk", "hideVirtual": true },
    { "type": "disk", "showRegular": true, "showExternal": true, "showHidden": false, "showSubvolumes": false, "showUnknown": false },
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}

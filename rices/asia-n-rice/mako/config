# archenemy - mako config (asia-n-rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=10
padding=14,16
anchor=top-right
layer=overlay

background-color=#2a3444F0
text-color=#e8e8e8
border-size=1
border-color=#b4768755
border-radius=14
progress-color=over #b4768755

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
border-color=#232d3980
default-timeout=3500

[urgency=critical]
background-color=#b47687F0
text-color=#182130
border-color=#b47687
default-timeout=0

[mode=do-not-disturb]
invisible=1

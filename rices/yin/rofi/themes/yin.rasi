/*
 * rofi theme — yin rice (czerń z białym akcentem, matowe szkło)
 * accent: #FFFFFF (biel) | text: #E6E6EA | dim: #8C8C96 | urgent: #E0805A (żar — wyłącznie alarmy)
 * bg: grafit #121215 z alfą 0.72 (≥ ignore_alpha 0.5 → blur Hyprlanda = matowe szkło)
 * layout: center | corners: 12 — jak tafle okien i wyspy waybara
 */

* {
    bg:          rgba(18, 18, 21, 0.72);
    bg-selected: rgba(255, 255, 255, 0.10);
    fg:          #D7D7DC;
    fg-dim:      #8C8C96;
    accent:      #FFFFFF;
    bright:      #FFFFFF;
    urgent:      #E0805A;
    border-col:  rgba(255, 255, 255, 0.12);

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    12px;
    width:            520px;
    padding:          0px;
    location:         center;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

/* ── Input bar ──────────────────────────────────────── */
inputbar {
    background-color: transparent;
    text-color:       @fg;
    padding:          16px 20px;
    spacing:          12px;
    children:         [ prompt, entry ];
    border:           0px 0px 1px 0px solid;
    border-color:     rgba(255, 255, 255, 0.08);
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font 11";
    vertical-align:   0.5;
}

entry {
    font:             "JetBrainsMono Nerd Font 11";
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       @bright;
    placeholder:      "Search…";
    placeholder-color: @fg-dim;
    cursor-color:     @accent;
    cursor-width:     2px;
    expand:           true;
}

/* ── List ───────────────────────────────────────────── */
listview {
    background-color: transparent;
    padding:          8px;
    spacing:          2px;
    scrollbar:        false;
    lines:            8;
    fixed-height:     true;
    cycle:            true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    spacing:          12px;
    orientation:      horizontal;
    border-radius:    8px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @bright;
}

element normal.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       #0C0C0E;
}

element-icon {
    background-color: transparent;
    size:             20px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    expand:           true;
}

# =============================================
#   archenemy · yin · kolory zsh
#   Kontrast WCAG >= 4.5:1 względem tła #0C0C0E (bez przezroczystości).
#   Plik ustawia style; wtyczki ładuje użytkownik osobno.
# =============================================
#   Monochrom jak alacritty/nvim: tekst #E6E6EA, akcent biel #FFFFFF,
#   ścieżki #C6C6CC, napisy #A6A6AD, komentarze i podpowiedzi #868690
#   (najciemniejszy kolor tekstu). Żar #E0805A wyłącznie dla błędów.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#868690'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[command]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[function]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#E6E6EA'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#FFFFFF'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=#FFFFFF'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=#FFFFFF'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#E0805A,underline'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#FFFFFF'
ZSH_HIGHLIGHT_STYLES[path]='fg=#C6C6CC'

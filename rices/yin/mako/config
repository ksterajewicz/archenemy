# archenemy - mako config (yin rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=12
padding=16
anchor=top-right
layer=overlay

# Matowe szkło: grafit #121215 z alfą ~0.78 (blur łapie ≥ 0.5), tekst w papierze
# #E6E6EA, krawędź tafli = biała linia z alfą ~0.16. Rogi 12 px jak okna i waybar.
background-color=#121215C7
text-color=#E6E6EA
border-size=1
border-color=#FFFFFF29
border-radius=12
progress-color=over #FFFFFF26

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
text-color=#8C8C96
default-timeout=3500

[urgency=critical]
# Żar — jedyny ciepły kolor palety, wyłącznie alarmy (czerń na żarze 6,9:1)
background-color=#E0805AF2
text-color=#0C0C0E
border-color=#E0805A
default-timeout=0

[mode=do-not-disturb]
invisible=1

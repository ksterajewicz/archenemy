{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "reload_style_on_change": true,
    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["custom/profileswitcher", "custom/micmute", "custom/volumebar", "network", "battery", "tray"],
    // Workspace'y: pasek pokazuje tylko swój output ({name}: w decades = 1-10
    // przez defaultName, w shared = globalne id). Scroll przez ws-scroll.sh —
    // naprawa pod dwa tryby (stały r±1 psułby scroll w trybie shared).
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "~/archenemy/scripts/hypr/ws-scroll.sh up",
        "on-scroll-down": "~/archenemy/scripts/hypr/ws-scroll.sh down",
        "all-outputs": false,
        "show-special": false
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Alacritty": "  $1",
            "(.*) - Brave":     "󰖟 $1"
        }
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%a, %d %b · %H:%M:%S}",
        "interval": 1,
        // Nagłówek tooltipa = pełna data dnia w akcencie; niżej siatka miesiąca.
        "tooltip-format": "<tt><span color='#0148ED'><big>{:%A, %d %B %Y}</big></span>\n\n{calendar}</tt>",
        // Kalendarz miesięczny BEZ kolumny numerów tygodni — ISO-tygodnie (31-36)
        // po lewej w pionie myliły się z dniami sąsiedniego miesiąca; usunięte
        // 2026-08-10. iso8601 zostaje = tydzień od poniedziałku. Nawigacja: scroll
        // = miesiące, PPM = rok/miesiąc; LPM = format-alt. (fix istniejącego — beta: bug-fixy)
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "iso8601": true,
            "format": {
                "months":   "<span color='#0148ED'><b>{}</b></span>",
                "days":     "<span color='#0a0a0a'>{}</span>",
                "weekdays": "<span color='#909090'>{}</span>",
                "today":    "<span color='#ffffff' background='#0148ED'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/profileswitcher": {
        "exec": "~/archenemy/scripts/waybar/profile-get.sh",
        "interval": 0.5,
        "format": "󰓅 {}",
        "on-click": "~/archenemy/scripts/waybar/profile-switch.sh; pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": false
    },
    "custom/micmute": {
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo '󰍭' || echo '󰍬'",
        "interval": 1,
        "format": "{}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; pkill -RTMIN+9 waybar",
        "signal": 9,
        "tooltip": false
    },
    // Pasek głośności (skrypt renderuje ▮▮▯ + %); styl przełączalny w Super+A
    // → [v]. Reaguje: interval:1 (backstop) + signal:10 (klawisze/scroll wołają
    // pkill -RTMIN+10). exec-on-event odświeża od razu po scrollu/kliknięciu.
    "custom/volumebar": {
        "exec": "~/archenemy/scripts/waybar/volume-bar.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 10,
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "on-click": "command -v pavucontrol >/dev/null && pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi":         "󰖩 {essid}",
        "format-ethernet":     "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi":     "{essid} · {signalStrength}%\n{ipaddr}/{cidr}\n{bandwidthDownBits} ↓  {bandwidthUpBits} ↑",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "on-click": "networkmanager_dmenu"
    },
    "battery": {
        "states": {
            "warning":  25,
            "critical": 10
        },
        "format":           "{icon} {capacity}%",
        "format-charging":  "󰂄 {capacity}%",
        "format-plugged":   "󰚥 {capacity}%",
        "format-icons":     ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format":   "{timeTo}\n{power}W"
    },
    "tray": {
        "icon-size": 14,
        "spacing":   8
    }
}

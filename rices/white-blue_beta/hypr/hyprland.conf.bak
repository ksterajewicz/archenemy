# ~/archenemy/rices/white-blue_beta/hypr/hyprland.conf
# made by kst - https://github.com/ksterajewicz
# github - https://github.com/ksterajewicz/archenemy 

$mainMod      = SUPER
$terminal     = alacritty
$filemanager  = thunar
$menu         = rofi -show drun
$browser      = brave
$lock         = hyprlock
$gamelauncher = steam
$networkmanager_gui = networkmanager_dmenu
$theme_menu   = ~/archenemy/scripts/rofi/rofi_theme_switcher.sh
$wallpaper_menu = ~/archenemy/scripts/rofi/rofi_wallpaper_switcher.sh 

# GPU + Wayland + scaling 
source = ~/archenemy/config/hypr/gpu_wayland_scaling.conf
source = ~/archenemy/config/hypr/gpu-env.conf

# Autostart
exec-once = waybar
exec-once = hyprpaper
exec-once = mako
exec-once = systemctl --user start hyprpolkitagent
exec-once = wl-paste --type text  --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
source = ~/archenemy/config/hypr/autostartpersonalisation.conf

xwayland {
    force_zero_scaling = true
}

# Monitors
source = ~/archenemy/config/hypr/monitorshyprl.conf

# Workspaces
source = ~/archenemy/config/hypr/workspaces.conf
source = ~/archenemy/config/hypr/workspaces-monitors.conf

general {
    gaps_in      = 6
    # Góra = 4 (równa margin-top waybara z config.jsonc) — przerwa pasek-okno
    # ma być identyczna jak pasek-krawędź ekranu. Kolejność: góra prawo dół lewo.
    gaps_out     = 4, 12, 12, 12
    border_size  = 2

    col.active_border   = rgb(0148ED)
    col.inactive_border = rgb(888888)

    layout           = dwindle
    resize_on_border = true
    allow_tearing    = true
}

gesture = 3, horizontal, workspace
gesture = 4, horizontal, workspace

misc {
    disable_hyprland_logo        = true
    disable_splash_rendering     = true
    force_default_wallpaper      = 0
    vrr                          = 1
    mouse_move_enables_dpms      = true
    key_press_enables_dpms       = true
    enable_swallow               = true
    swallow_regex                = ^(Alacritty)$
    focus_on_activate            = false
    animate_manual_resizes       = false
    animate_mouse_windowdragging = false
}

cursor {
    no_hardware_cursors      = true
    enable_hyprcursor        = true
    warp_on_change_workspace = false
}

dwindle {
    preserve_split       = true
    smart_split          = false
    smart_resizing       = true
    force_split          = 0
    special_scale_factor = 0.95
}

# Apps
bind = $mainMod, RETURN, exec, $terminal
bind = $mainMod, E,      exec, $filemanager
bind = $mainMod, R,      exec, $menu
bind = $mainMod, B,      exec, $browser
bind = $mainMod, S,      exec, $gamelauncher
bind = $mainMod, N,      exec, $networkmanager_gui
bind = $mainMod, T,      exec, $theme_menu 
bind = $mainMod, W,      exec, $wallpaper_menu
bind = $mainMod, L,      exec, $lock

# Keyboard language
# Allows the user to switch between any two chosen keyboard layouts.
bind = $mainMod, K, exec, hyprctl switchxkblayout all next

input {
    kb_layout    = pl,us
    kb_options   = grp:alt_shift_toggle

    follow_mouse  = 1
    sensitivity   = 0
    accel_profile = flat

    touchpad {
        natural_scroll        = true
        disable_while_typing  = true
        tap-to-click          = true
        scroll_factor         = 0.5
    }
}

# Window control
bind = $mainMod,       Q, killactive
    #kills active window
bind = $mainMod,       V, togglefloating
    #enables floating on active window
bind = $mainMod,       F, fullscreen
    #makes active window go fullscreen
bind = $mainMod,       P, pseudo
bind = $mainMod SHIFT, F, fullscreen, 1

# Focus
bind = $mainMod, left,  movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up,    movefocus, u
bind = $mainMod, down,  movefocus, d

# Move windows
bind = $mainMod SHIFT, left,  movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up,    movewindow, u
bind = $mainMod SHIFT, down,  movewindow, d

# Resize
binde = $mainMod ALT, left,  resizeactive, -40 0
binde = $mainMod ALT, right, resizeactive,  40 0
binde = $mainMod ALT, up,    resizeactive,   0 -40
binde = $mainMod ALT, down,  resizeactive,   0  40

# Monitor focus
bind = $mainMod, period, focusmonitor, +1
bind = $mainMod, comma,  focusmonitor, -1

# Mouse drag
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Screenshots
bind = , PRINT, exec, hyprshot -m region --clipboard-only
bind = $mainMod, PRINT, exec, hyprshot -m region -o $HOME/Screenshots

# Keybindings depending on the keyboard model
source = ~/archenemy/config/hypr/keyboard.conf
source = ~/archenemy/config/hypr/hardware-keys.conf

# Window rules
windowrule = match:class ^(thunar)$, match:title ^(File Operation Progress)$, float on
windowrule = match:title ^(Open File)$, float on
windowrule = match:title ^(Save File|Save As)$, float on
windowrule = match:class ^(xdg-desktop-portal-gtk)$, float on
windowrule = match:title ^(Picture-in-Picture)$, float on
windowrule = match:title ^(Picture-in-Picture)$, pin on
windowrule = match:title ^(Picture-in-Picture)$, size 480 270
windowrule = match:title ^(Picture-in-Picture)$, move 100%-490 100%-280
source = ~/archenemy/config/hypr/custom_window_rules.conf

# Layer rules
layerrule = match:namespace ^(waybar)$, blur on
layerrule = match:namespace ^(waybar)$, ignore_alpha 0.5
layerrule = match:namespace ^(notifications)$, blur on
layerrule = match:namespace ^(notifications)$, ignore_alpha 0.5
layerrule = match:namespace ^(notifications)$, animation slide
layerrule = match:namespace ^(rofi)$, blur on
layerrule = match:namespace ^(rofi)$, ignore_alpha 0.5
layerrule = match:namespace ^(rofi)$, animation popin 80%


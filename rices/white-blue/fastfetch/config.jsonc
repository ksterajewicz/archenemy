// archenemy — fastfetch (white-blue): logo Archa i klucze w dominującym
// niebieskim rice'a (#0148ED, jaśniejszy #4A7FFF jak w gradiencie ramek).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "38;2;1;72;237", "2": "38;2;74;127;255" }
  },
  "display": {
    "color": { "keys": "38;2;1;72;237", "title": "38;2;1;72;237" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    // Font terminala z uwzględnieniem wyboru Super+A → [f]; rodzina jest w importach
    // alacritty (font.toml), których terminalfont może nie uwzględniać. fastfetch po
    // cichu pomija wiersz, gdy polecenie nic nie wypisze (np. skrypt niedostępny),
    // więc zapasowo czytamy te same pliki co alacritty; wynik nigdy nie jest pusty.
    { "type": "command", "key": "Terminal Font", "text": "f=$(bash \"$HOME/archenemy/scripts/appbinds/font-settings.sh\" current 2>/dev/null); [ -n \"$f\" ] || f=$(sed -n 's/^[[:space:]]*family[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1 (alacritty config)/p' \"$HOME/.config/archenemy/fonts/alacritty.toml\" \"$HOME/.config/alacritty/font.toml\" 2>/dev/null | head -n 1); echo \"${f:-unknown (font-settings.sh and alacritty font files unavailable)}\"" },
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}


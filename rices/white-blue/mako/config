# archenemy - mako config (white-blue rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=10
padding=14,16
anchor=top-right
layer=overlay

background-color=#FFFFFFD9
text-color=#0A0A0A
border-size=1
border-color=#0148ED40
border-radius=14
progress-color=over #0148ED55

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
border-color=#9AA5B140
default-timeout=3500

[urgency=critical]
background-color=#0148EDF0
text-color=#FFFFFF
border-color=#0148ED
default-timeout=0

[mode=do-not-disturb]
invisible=1

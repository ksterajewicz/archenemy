# archenemy - mako config (tron rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=10
padding=14,16
anchor=top-right
layer=overlay

background-color=#020A0FE6
text-color=#9ADBE8
border-size=1
border-color=#00E5FF66
border-radius=6
progress-color=over #00E5FF55

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
border-color=#0E2A3366
default-timeout=3500

[urgency=critical]
# Pomarańcz CLU — semantyczny kolor alarmu w rice tron
background-color=#FF7B1CF0
text-color=#020A0F
border-color=#FF7B1C
default-timeout=0

# Tryb „nie przeszkadzać” (dzwonek w waybarze, scripts/waybar/dnd.sh) chowa
# powiadomienia aplikacji. Kolejność sekcji niżej MA znaczenie — mako(5): przy
# kilku pasujących sekcjach wygrywa ostatnia wartość opcji.
[mode=do-not-disturb]
invisible=1

# Krytyczne (urgency=critical) przechodzą — także z aplikacji.
[mode=do-not-disturb urgency=critical]
invisible=0

# Powiadomienia archenemy (notify-send -a archenemy: profil zasilania, rice,
# tapeta, Bluetooth, timer…) przechodzą przy każdej pilności.
[mode=do-not-disturb app-name=archenemy]
invisible=0

# …i grupują się jak poza trybem (group-by=app-name): widać pierwsze z grupy
# z licznikiem, reszta schowana. Bez tych dwóch sekcji sekcja wyżej odsłania
# każde z grupy osobno (wbudowane [grouped] invisible=1 stoi przed configiem).
[mode=do-not-disturb app-name=archenemy grouped]
invisible=1

[mode=do-not-disturb app-name=archenemy group-index=0]
invisible=0

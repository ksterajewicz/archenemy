# archenemy - mako config (dither-flux rice)
# made by kst - https://github.com/ksterajewicz

font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=10
padding=14,16
anchor=top-right
layer=overlay

background-color=#14222EF5
text-color=#A8C4D4
border-size=1
border-color=#D8E6EE66
border-radius=0
progress-color=over #D8E6EE55

default-timeout=5000
max-history=20
group-by=app-name
icons=1
max-icon-size=40

[urgency=low]
border-color=#1B304066
default-timeout=3500

[urgency=critical]
# Bursztyn — jedyny ciepły kolor palety, zarezerwowany dla alarmów
background-color=#E0A23CF0
text-color=#0F1A24
border-color=#E0A23C
default-timeout=0

[mode=do-not-disturb]
invisible=1

# Krytyczne (urgency=critical: koniec timera, błędy archenemy) przechodzą także
# w trybie „nie przeszkadzać” (dzwonek w waybarze, scripts/waybar/dnd.sh).
# Sekcja MUSI stać po [mode=do-not-disturb] — mako(5): przy kilku pasujących
# sekcjach wygrywa ostatnia wartość opcji.
[mode=do-not-disturb urgency=critical]
invisible=0
